# =============================================================================
# 文迹 · article_trace 环境变量示例
# -----------------------------------------------------------------------------
# 用法：cp .env.example .env  然后填入真实值
#       （.env 已被 .gitignore 忽略，不会提交到仓库；本示例文件可以提交）
# 说明：docker-compose.yml 中以 ${VAR:?...} 引用的变量为必填，缺失时
#       compose 会直接报错并提示；其余为可选覆盖项，留空即用默认值。
# =============================================================================

# ---------- 必填：MySQL ----------
# MySQL root 口令，同时作为后端数据库口令
DB_PASSWORD=change_me_db_password

# ---------- 必填：Redis ----------
REDIS_PASSWORD=change_me_redis_password

# ---------- 必填：RustFS（S3 兼容对象存储）凭据 ----------
# 注意：不要使用带斜杠或大写字母的 access key
RUSTFS_ACCESS_KEY=change_me_rustfs_key
RUSTFS_SECRET_KEY=change_me_rustfs_secret
# 桶名（不填用默认值 pic / content / avatar）
# 建桶（rustfs-init）与后端读写用的是同一组值，改就一起改。
RUSTFS_PIC_BUCKET=pic
RUSTFS_CONTENT_BUCKET=content
RUSTFS_AVATAR_BUCKET=avatar

# ---------- 必填：应用密钥 ----------
# JWT 签名密钥：泄露即可伪造任意用户 token，请用足够长的随机串
JWT_SECURE_KEY=change_me_random_long_string
# 站长密码（删除他人文章等高危操作需二次校验）
MASTER_PASS=change_me_master_password
# 默认站长账号初始口令（首次启动自动创建该账号；密码重置走邮箱验证码）
DEFAULT_USER_PASS=change_me_admin_password

# ---------- 可选：默认站长账号资料（非敏感） ----------
DEFAULT_USER_ID=apkdio
DEFAULT_USER_EMAIL=article_trace@trace.com

# ---- 邮件（SMTP）：验证码与站内通知的投递通道 ----
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your_mail@qq.com
MAIL_PASSWORD=change_me_smtp_auth_code
MAIL_FROM=
# 邮件模板里的 logo 地址。
# 推荐做法：logo 已放在 article_trace_front/public/logo2.png，构建后由 Nginx 直接托管，
# 所以这里填 https://你的域名/logo2.png 即可（换图就替换 public 下那个文件、重新构建）。
# 必须是**公网可访问的绝对 URL** —— 邮件客户端读不到相对路径，地址不可达时 logo 位置显示成裂图。
# 留空则 logo 位置为空，其余版式不受影响。
MAIL_LOGO_URL=

DEFAULT_USER_NICK_NAME=测试昵称

# ---------- 可选：测试库（仅本地/CI 跑 mvn test 时用到） ----------
# 测试连的是独立库，不会碰开发库；DB 号见 article_trace_back/src/test/resources/application.yml
# 初始化：python scripts/init_test_db.py
TEST_DB_USER=root
TEST_DB_PASSWORD=change_me_test_db_password
TEST_DB_NAME=article_trace_test

# ---------- 可选：对外端口映射（左边为宿主机端口） ----------
FRONTEND_PORT=8080          # 前端入口（Nginx）
BACKEND_PORT=8081           # 后端直连（调试）
MYSQL_PORT=3306
REDIS_PORT=6379
RUSTFS_PORT=9000            # S3 API
RUSTFS_CONSOLE_PORT=9001    # RustFS 控制台
OLLAMA_PORT=11434
AGENT_HOST_PORT=50051       # agent gRPC

# ---------- 可选：agent 开关 ----------
# false = 关闭检索问答（不建 gRPC 连接、不写同步/会话队列），主业务不受影响
AGENT_ENABLED=true

# ---------- 可选：Nginx 前端构建时无需，仅备查 ----------
# 无

# =============================================================================
# 文迹 · article_trace 环境变量示例
# -----------------------------------------------------------------------------
# 用法：cp .env.example .env  然后填入真实值
#       （.env 已被 .gitignore 忽略，不会提交到仓库；本示例文件可以提交）
# 说明：docker-compose.yml 中以 ${VAR:?...} 引用的变量为必填，缺失时
#       compose 会直接报错并提示；其余为可选覆盖项，留空即用默认值。
# =============================================================================

# ---------- 必填：MySQL ----------
# MySQL root 口令，同时作为后端数据库口令
DB_PASSWORD=change_me_db_password
# 连接串与用户名：留空用容器内的 mysql 服务（即默认值）。
# 接托管数据库时改这两项；URL 里的 useSSL 按服务商要求调整（托管库通常要 true）。
# DB_CONNECT_URL=jdbc:mysql://db.example.com:3306/article_trace?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
# DB_USER=article_trace

# ---------- 必填：Redis ----------
REDIS_PASSWORD=change_me_redis_password

# ---------- 必填：RustFS（S3 兼容对象存储）凭据 ----------
# 注意：不要使用带斜杠或大写字母的 access key
RUSTFS_ACCESS_KEY=change_me_rustfs_key
RUSTFS_SECRET_KEY=change_me_rustfs_secret
# 桶名（不填用默认值 pic / content / avatar）
# 建桶（rustfs-init）与后端读写用的是同一组值，改就一起改。
RUSTFS_PIC_BUCKET=pic
RUSTFS_CONTENT_BUCKET=content
RUSTFS_AVATAR_BUCKET=avatar

# ---------- 可选：对象存储对外地址（上公网必改） ----------
# 这个地址会被写进图片的预签名 URL，**浏览器必须能直接访问到它**。
# 默认值 http://rustfs:9000 是 Docker 内网名，本机跑没问题，公网浏览器解析不了，
# 表现是所有封面/头像加载失败。上公网要改成浏览器可达的地址，例如：
# RUSTFS_ENDPOINT=https://files.example.com
# 该域名需反代到 rustfs:9000。建议用**独立子域**而不是主域下的路径前缀——
# S3 签名把 Host 和路径都算进去了，路径前缀一旦被反代改写就会验签失败。
# 后端自己也会用这个地址读写对象（含上传），所以它也得能解析到该域名。
# RUSTFS_ENDPOINT=http://localhost:9000    # 本机非容器方式运行时用这个

# ---------- 可选：RustFS 控制台 ----------
# 上公网建议置 false，并把上面「对外端口映射」里的 RUSTFS_CONSOLE_PORT 映射删掉
# RUSTFS_CONSOLE_ENABLE=false

# ---------- 必填：应用密钥 ----------
# JWT 签名密钥：泄露即可伪造任意用户 token，请用足够长的随机串
JWT_SECURE_KEY=change_me_random_long_string
# 令牌 Cookie 是否只在 HTTPS 下发送。
# 本地 http 调试必须为 false，否则浏览器不会保存 Cookie，登录会一直失败；
# 站点上了 HTTPS 后改为 true（开启后跨站请求也拿不到它）。
JWT_COOKIE_SECURE=false
# 站长密码（删除他人文章等高危操作需二次校验）
MASTER_PASS=change_me_master_password
# 默认站长账号初始口令（首次启动自动创建该账号；密码重置走邮箱验证码）
DEFAULT_USER_PASS=change_me_admin_password

# ---------- 可选：默认站长账号资料（非敏感） ----------
DEFAULT_USER_ID=apkdio
DEFAULT_USER_EMAIL=article_trace@trace.com

# ---- 邮件（SMTP）：验证码与站内通知的投递通道 ----
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your_mail@qq.com
MAIL_PASSWORD=change_me_smtp_auth_code
MAIL_FROM=
# 邮件模板里的 logo 地址。
# 推荐做法：logo 已放在 article_trace_front/public/logo2.png，构建后由 Nginx 直接托管，
# 所以这里填 https://你的域名/logo2.png 即可（换图就替换 public 下那个文件、重新构建）。
# 必须是**公网可访问的绝对 URL** —— 邮件客户端读不到相对路径，地址不可达时 logo 位置显示成裂图。
# 留空则 logo 位置为空，其余版式不受影响。
MAIL_LOGO_URL=

DEFAULT_USER_NICK_NAME=测试昵称

# ---------- 可选：测试库（仅本地/CI 跑 mvn test 时用到） ----------
# 测试连的是独立库，不会碰开发库；DB 号见 article_trace_back/src/test/resources/application.yml
# 初始化：python scripts/init_test_db.py
TEST_DB_USER=root
TEST_DB_PASSWORD=change_me_test_db_password
TEST_DB_NAME=article_trace_test

# ---------- 可选：宿主机端口映射 ----------
# 所有端口都只绑到宿主机回环 127.0.0.1，不对局域网 / 公网开放（见 docker-compose.yml 头部说明）。
# 上公网时在宿主机挂 Nginx / Caddy 反代到 127.0.0.1:8080 并终止 TLS。
FRONTEND_PORT=8080          # 前端入口（Nginx）
BACKEND_PORT=8081           # 后端直连（调试）
MYSQL_PORT=3306
REDIS_PORT=6379
RUSTFS_PORT=9000            # S3 API
RUSTFS_CONSOLE_PORT=9001    # RustFS 控制台
OLLAMA_PORT=11434
AGENT_HOST_PORT=50051       # agent gRPC

# ---------- 可选：agent 开关 ----------
# false = 关闭检索问答（不建 gRPC 连接、不写同步/会话队列），主业务不受影响
AGENT_ENABLED=true

# ---------- 可选：agent 的模型端点（两机部署时主要改这一段） ----------
# 留空 = 用容器内 agent.yaml / chroma.yaml 的默认值（指向 compose 里的 ollama）。
# Ollama 单独部署在另一台机器（如 RTX 4090 那台）时，把地址填进来即可，
# 不必改配置文件、也不用重建镜像。空值会被忽略，不会覆盖 yaml 里的值。
#
# 接自建 Ollama：
# LLM_BASE_URL=http://192.168.1.10:11434/v1
# 接云端 OpenAI 兼容服务：
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_CHAT_MODEL=qwen2.5:7b
# LLM_TEMPERATURE=0.3
#
# embedding 与生成模型同端点时，只填上面的 LLM_* 就够——
# EMBED_* 会自动跟随；只有分开部署（如生成走云端、向量走本地）时才需要单独指定。
# EMBED_BASE_URL=
# EMBED_API_KEY=
# LLM_EMBED_MODEL=bge-m3

# ---------- 可选：Nginx 前端构建时无需，仅备查 ----------
# 无
